# ============================================================
# SGD-AJE - Variables de entorno de referencia
# No incluir secretos reales en este archivo.
# Cada aplicación tendrá después su propio .env.example.
# ============================================================

# Entorno
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sgd_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sgd_dev

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sgd
KEYCLOAK_CLIENT_ID=sgd-frontend

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=sgd_app
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=sgd

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_DOCUMENTS=sgd-documents
MINIO_BUCKET_QUARANTINE=sgd-quarantine

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=sgd-aje

# Aplicación
APP_TIMEZONE=America/Bogota
APP_LOCALE=es-CO